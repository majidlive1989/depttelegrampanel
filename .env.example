# Create a bot via @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Recommended: send /myid to the bot and put your numeric Telegram user ID here.
# Multiple admins: 123456789,987654321
TELEGRAM_ADMIN_IDS=

APP_TIMEZONE=Asia/Tehran
FOLLOWUP_INTERVAL_SECONDS=60
SEND_COOLDOWN_MINUTES=30
DATA_DIR=/app/data
